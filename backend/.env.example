# Free key from https://aistudio.google.com/apikey  (no billing needed)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: flight lookup. Free key: rapidapi.com -> AeroDataBox -> subscribe to the free Basic plan.
# Without it, travellers type their flights in by hand.
AERODATABOX_API_KEY=

# api.weather.gov asks clients to include a contact in the User-Agent
CONTACT_EMAIL=you@example.com

# Frontend origin(s) allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Trips shorter than this (straight-line miles) are treated as drives in "auto" mode
DRIVE_THRESHOLD_MILES=300
