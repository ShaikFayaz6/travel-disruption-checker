# Free key from https://aistudio.google.com/apikey  (no billing needed)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: flight lookup. Free key: rapidapi.com -> AeroDataBox -> subscribe to the free Basic plan.
# Without it, travellers type their flights in by hand.
AERODATABOX_API_KEY=

# api.weather.gov asks clients to include a contact in the User-Agent
CONTACT_EMAIL=you@example.com

# Frontend origin(s) allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Trips shorter than this (straight-line miles) are treated as drives in "auto" mode
DRIVE_THRESHOLD_MILES=300

# --- Accounts, paywall, payments and analytics (all optional: leave empty to switch them off) ---
# Supabase -> Connect -> Session pooler URI (postgresql://...). With SUPABASE_URL it switches the paywall on.
DATABASE_URL=
# https://<ref>.supabase.co : used to check sign-in tokens (JWKS)
SUPABASE_URL=
# Optional: the legacy HS256 JWT secret. Empty = check tokens with the project's public keys (JWKS)
SUPABASE_JWT_SECRET=
# Any long random string: visitors' IPs are stored only as a salted hash
IP_HASH_SALT=
# Stripe test mode secret key (sk_test_...). With the two below it switches billing on.
STRIPE_SECRET_KEY=
# whsec_... from `stripe listen` (local) or the dashboard webhook endpoint (Render)
STRIPE_WEBHOOK_SECRET=
# price_... printed by: python scripts/stripe_setup.py
STRIPE_PRICE_ID=
# Where Stripe sends people back after Checkout and the billing portal
FRONTEND_URL=http://localhost:3000
# GA4 Measurement ID (G-...) and Measurement Protocol API secret, for the server-side purchase event
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
# true = server-side GA4 events also show in GA4's DebugView (testing only)
GA4_DEBUG=false
