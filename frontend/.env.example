# Copy to .env.local. Everything here is optional: empty = no sign-in, no paywall, no tracking.
# NEXT_PUBLIC_ values are built into the page, so change them, then restart `npm run dev` (or rebuild).

# Supabase -> Project Settings -> API: the project URL
NEXT_PUBLIC_SUPABASE_URL=
# The publishable/anon key (safe in the browser; never the service_role key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Google Tag Manager container ID (GTM-...). Empty = no tracking
NEXT_PUBLIC_GTM_ID=
# true = show "Sign in with Google" (turn on the Google provider in Supabase first)
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false
# Leave empty locally. In production: the Render backend URL, so the stream skips Vercel's proxy
NEXT_PUBLIC_STREAM_URL=
